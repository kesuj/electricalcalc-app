# Copy this file to .env and fill in only what you use. Never commit .env.
ECALC_APP_NAME=ElectricalCalc AI
ECALC_APP_TAGLINE=Intelligent Electrical Engineering Assistant

# --- Cost controls -----------------------------------------------------------
# 0 = paid AI providers (Anthropic API) are completely blocked.
ECALC_MONTHLY_BUDGET_USD=0
ECALC_MAX_COST_PER_REQUEST_USD=0.05
ECALC_AI_TIMEOUT_SECONDS=60
ECALC_MAX_UPLOAD_MB=20

# --- Free / local providers --------------------------------------------------
# Google Gemini (free tier: prompts may be used by Google to improve products)
GEMINI_API_KEY=
ECALC_GEMINI_MODEL=gemini-flash-latest
# OpenRouter - only model ids ending in ":free" are accepted by the app
OPENROUTER_API_KEY=
ECALC_OPENROUTER_MODEL=
# Ollama (local, private) - install from ollama.com, then: ollama pull llama3.2:3b
OLLAMA_HOST=http://localhost:11434
ECALC_OLLAMA_MODEL=llama3.2:3b

# --- Paid provider (or Max-plan API credits once claimed) ---------------------
ANTHROPIC_API_KEY=
ECALC_ANTHROPIC_MODEL=claude-opus-5-5
# optional: low | medium | high  (lower effort = fewer tokens = lower cost)
ECALC_ANTHROPIC_EFFORT=
